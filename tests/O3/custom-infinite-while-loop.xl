// TIMEOUT=30s

bar [[true]], SomeBody is SomeBody
bar [[false]], SomeOtherBody is false

foo Condition, Body is
    bar Condition,
        Body
        foo Condition, Body


I := 0
foo I < 10_000_000_000,
    I := I + 1
    bar I mod 1_000_000_000 = 0,
        print "I=", I
print "At end I=", I
